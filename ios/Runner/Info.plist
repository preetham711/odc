<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Bundle identity ───────────────────────────────────────────────── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ODC Tracker AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ODC Tracker AI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ── iOS Deployment ────────────────────────────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>

	<!-- ── Interface orientations (portrait-first) ───────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch screen ─────────────────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Background modes ──────────────────────────────────────────────── -->
	<!-- Required for: remote notifications, background fetch, background processing -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>

	<!-- ── Face ID / Touch ID (local_auth) ───────────────────────────────── -->
	<key>NSFaceIDUsageDescription</key>
	<string>ODC Tracker AI uses Face ID to securely unlock the app and protect your attendance data.</string>

	<!-- ── Notifications ─────────────────────────────────────────────────── -->
	<!-- Enables time-sensitive notifications (break reminders bypass Focus) -->
	<key>NSUserNotificationsUsageDescription</key>
	<string>ODC Tracker AI sends break reminders and shift alerts to help you track your ODC hours.</string>

	<!-- ── Camera & Photo Library (profile photo) ────────────────────────── -->
	<key>NSCameraUsageDescription</key>
	<string>ODC Tracker AI needs camera access to update your profile photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ODC Tracker AI needs photo library access to select a profile photo.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ODC Tracker AI needs permission to save your profile photo.</string>

	<!-- ── Siri Shortcuts / App Intents ──────────────────────────────────── -->
	<!-- Enables deep-link URL scheme for Siri Shortcuts -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.odctracker.odcTrackerAi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>odctracker</string>
			</array>
		</dict>
		<!-- Uncomment and fill in after adding iOS app in Firebase Console:
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>YOUR_REVERSED_CLIENT_ID_FROM_GoogleService-Info.plist</string>
			</array>
		</dict>
		-->
	</array>

	<!-- ── Performance ───────────────────────────────────────────────────── -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── App Transport Security ────────────────────────────────────────── -->
	<!-- Firebase requires network access -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>firebaseapp.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- ── Handoff / Universal Links ─────────────────────────────────────── -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:odctracker.app</string>
	</array>
</dict>
</plist>
