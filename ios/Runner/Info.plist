<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Bundle identity ───────────────────────────────────────────────── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ODC Tracker AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ODC Tracker AI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ── iOS Deployment ────────────────────────────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>

	<!-- ── Interface orientations ────────────────────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch screen ─────────────────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Notifications ─────────────────────────────────────────────────── -->
	<!-- Required for flutter_local_notifications on iOS -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- Local notifications: time-sensitive interruption support (iOS 15+) -->
	<!-- Declare the entitlement key even without an explicit usage description;
	     the actual Time Sensitive entitlement must be enabled in Xcode Signing. -->

	<!-- ── Firebase / Messaging ──────────────────────────────────────────── -->
	<!-- Add your actual REVERSED_CLIENT_ID from GoogleService-Info.plist here -->
	<!-- <key>CFBundleURLTypes</key> -->
	<!-- <array>                                                               -->
	<!--   <dict>                                                              -->
	<!--     <key>CFBundleTypeRole</key><string>Editor</string>               -->
	<!--     <key>CFBundleURLSchemes</key>                                     -->
	<!--     <array><string>YOUR_REVERSED_CLIENT_ID</string></array>          -->
	<!--   </dict>                                                             -->
	<!-- </array>                                                              -->

	<!-- ── Performance ───────────────────────────────────────────────────── -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Privacy usage descriptions ───────────────────────────────────── -->
	<!-- iOS 14+ requires these keys; App Store review will reject the app    -->
	<!-- without them if the corresponding hardware/permission is requested.  -->
	<key>NSCameraUsageDescription</key>
	<string>ODC Tracker AI needs camera access to update your profile photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ODC Tracker AI needs photo library access to select a profile photo.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>ODC Tracker AI sends break reminders and shift alerts to help you track your ODC hours.</string>
</dict>
</plist>
