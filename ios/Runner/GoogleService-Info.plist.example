<!--
  ┌──────────────────────────────────────────────────────────────────────────┐
  │  GoogleService-Info.plist — iOS Firebase Configuration                   │
  │                                                                           │
  │  THIS IS A TEMPLATE FILE. Do NOT use these placeholder values.           │
  │                                                                           │
  │  To get the real file:                                                    │
  │   1. Open console.firebase.google.com                                     │
  │   2. Select project: odc-tracker                                          │
  │   3. Click "Add app" → iOS                                                │
  │   4. Bundle ID: com.odctracker.odcTrackerAi                               │
  │   5. Download GoogleService-Info.plist                                    │
  │   6. Add it to Xcode: right-click Runner → Add Files to Runner            │
  │      ✅ Copy items if needed                                               │
  │      ✅ Add to target: Runner                                              │
  │                                                                           │
  │  Do NOT add the real file to Git — it contains API keys.                 │
  │  Add it to .gitignore: ios/Runner/GoogleService-Info.plist               │
  └──────────────────────────────────────────────────────────────────────────┘
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE_WITH_REAL_VALUE</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>REPLACE_WITH_REAL_VALUE</string>
	<key>API_KEY</key>
	<string>REPLACE_WITH_REAL_VALUE</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_REAL_VALUE</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.odctracker.odcTrackerAi</string>
	<key>PROJECT_ID</key>
	<string>odc-tracker</string>
	<key>STORAGE_BUCKET</key>
	<string>odc-tracker.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_WITH_REAL_VALUE</string>
</dict>
</plist>
