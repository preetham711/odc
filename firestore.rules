rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isUserAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAdminUser() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
    
    function isAnyAdmin() {
      return isUserAdmin() || isAdminUser();
    }
    
    function isSuperAdmin() {
      return isAdminUser() && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isSuperAdmin == true;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      allow create: if isSignedIn() && isOwner(userId) && 
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.role == 'user' && 
                       request.resource.data.isDisabled == false;
      allow update: if (isSignedIn() && isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'role', 'isDisabled', 'createdAt'])) || isAnyAdmin();
      allow delete: if isAnyAdmin();
      
      match /attendance/{attendanceId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
      
      match /workSchedules/{scheduleId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
        allow delete: if isAnyAdmin();
      }
      
      match /leaves/{leaveId} {
        allow read: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if (isSignedIn() && isOwner(userId) && 
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'cancelled') || isAnyAdmin();
        allow delete: if isAnyAdmin();
      }
      
      match /tasks/{taskId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
      
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
      
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
      
      match /reminder_history/{reminderId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
      
      match /sessions/{sessionId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      }
    }
    
    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (isOwner(adminId) || isAdminUser());
      allow create: if (isSignedIn() && isOwner(adminId)) || isSuperAdmin();
      allow update: if (isSignedIn() && isOwner(adminId) && 
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'permissions', 'isSuperAdmin', 'isActive', 'createdAt'])) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // Leave Balances
    match /leave_balances/{balanceId} {
      allow read: if isSignedIn() && 
                     (balanceId.matches('^' + request.auth.uid + '_.*') || isAnyAdmin());
      allow create, update: if (isSignedIn() && 
                               balanceId.matches('^' + request.auth.uid + '_.*')) || isAnyAdmin();
      allow delete: if false;
    }
    
    // Monthly Reports
    match /monthly_reports/{reportId} {
      allow read: if isSignedIn() && 
                     (reportId.matches('^' + request.auth.uid + '_.*') || isAnyAdmin());
      allow create, update: if isAnyAdmin();
      allow delete: if false;
    }
    
    // Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read, create: if isAnyAdmin();
      allow update, delete: if false;
    }
    
    // Deleted Users
    match /deleted_users/{userId} {
      allow read, create: if isAnyAdmin();
      allow update, delete: if false;
    }
    
    // Settings
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }
    
    // Reports
    match /reports/{reportId} {
      allow read, write: if isAnyAdmin();
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
