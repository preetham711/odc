rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAdminUser() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
    
    function isAnyAdmin() {
      return isAdmin() || isAdminUser();
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    // Admins collection - separate from users
    match /admins/{adminId} {
      // Allow authenticated users to create their own admin document (for initial setup)
      allow create: if isSignedIn() && isOwner(adminId);
      
      // Admins can read their own profile
      allow read: if isOwner(adminId) || isAdminUser();
      
      // Only super admins can create/update/delete other admins
      allow create, update: if isAdminUser() && 
                              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isSuperAdmin == true;
      
      // Admins can update their own profile (except permissions and isSuperAdmin)
      allow update: if isOwner(adminId) && 
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'isSuperAdmin', 'isActive']));
      
      // Only super admins can delete admins
      allow delete: if isAdminUser() && 
                       get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isSuperAdmin == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all
      allow read: if isOwner(userId) || isAnyAdmin();
      
      // Users can update their own data (except role field)
      allow update: if isOwner(userId) && 
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      // Only admins can create users or modify roles
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin();
      
      // Only admins can delete users
      allow delete: if isAnyAdmin();
      
      // Subcollections for user-specific data
      match /attendance/{attendanceId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /workSchedules/{scheduleId} {
        allow read: if isOwner(userId) || isAnyAdmin();
        allow write: if isAnyAdmin();
      }
      
      match /reminder_history/{reminderId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAnyAdmin();
      }
      
      match /leaves/{leaveId} {
        // Users can read/create their own leave requests
        allow read: if isOwner(userId) || isAnyAdmin();
        allow create: if isOwner(userId);
        
        // Users can update their own pending leaves (cancel)
        allow update: if isOwner(userId) && 
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'cancelled';
        
        // Admins can update for approval/rejection
        allow update: if isAnyAdmin();
        
        // Only admins can delete
        allow delete: if isAnyAdmin();
      }
    }
    
    // Admin audit logs - only admins can read, system writes
    match /admin_audit_logs/{logId} {
      allow read: if isAnyAdmin();
      allow create: if isAnyAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }
    
    // Deleted users collection - only admins can read
    match /deleted_users/{userId} {
      allow read: if isAnyAdmin();
      allow create: if isAnyAdmin();
      allow update, delete: if false; // Deletion markers are immutable
    }
    
    // Company/organization settings
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }
    
    // Reports and analytics - admin only
    match /reports/{reportId} {
      allow read, write: if isAnyAdmin();
    }
    
    // Monthly reports - users can read their own, admins can read all
    match /monthly_reports/{reportId} {
      allow read: if isSignedIn() && 
                     (reportId.split('_')[0] == request.auth.uid || isAnyAdmin());
      allow create, update: if isAnyAdmin();
      allow delete: if false; // Reports are immutable once created
    }
    
    // Leave balances - users can read their own, admins can read/write all
    match /leave_balances/{balanceId} {
      allow read: if isSignedIn() && 
                     (balanceId.split('_')[0] == request.auth.uid || isAnyAdmin());
      allow create, update: if isAnyAdmin();
      allow delete: if false; // Balances should not be deleted
    }
    
    // Block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
